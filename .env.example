WIKIJS_URL=https://wiki.example.com/graphql
# Optional for read-only public wikis, required for private/write operations.
WIKIJS_API_TOKEN=
WIKIJS_LOCALE=ko

# FastMCP HTTP server settings
MCP_HOST=127.0.0.1
MCP_PORT=8000
MCP_PATH=/mcp

# Docker Compose host port. Change this if port 8000 is already in use.
MCP_HTTP_PORT=8000
